{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RackTop",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [
          "openssh-client",
          "xdg-utils",
          "x-terminal-emulator",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libdbus-1-3"
        ],
        "recommends": [
          "gnome-keyring"
        ]
      }
    }
  }
}
